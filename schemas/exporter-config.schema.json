    "FailureDetectionConfigV1Alpha1": {
      "description": "Configuration for rapid failure detection in the exporter restart loop.\n\nIf the child process fails within ``rapid_failure_window`` seconds of\nstarting, it is counted as a \"rapid failure\".  After\n``max_rapid_failures`` consecutive rapid failures the main process exits\nwith code 1 so that systemd / the container orchestrator can recreate the\ncontainer.",
      "properties": {
        "maxRapidFailures": {
          "default": 5,
          "description": "Number of consecutive rapid failures before the exporter exits.",
          "title": "Maxrapidfailures",
          "type": "integer"
        },
        "rapidFailureWindow": {
          "default": 60,
          "description": "Seconds - a child that exits faster than this counts as a rapid failure.",
          "title": "Rapidfailurewindow",
          "type": "integer"
        }
      },
      "title": "FailureDetectionConfigV1Alpha1",
      "type": "object"
    },
    "HookConfigV1Alpha1": {
      "description": "Configuration for lifecycle hooks.",
      "properties": {
