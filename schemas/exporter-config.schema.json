  "$id": "https://jumpstarter.dev/schemas/exporter-config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Exporter configuration (jumpstarter.dev/v1alpha1 ExporterConfig).\n\nStores credentials, endpoint, driver tree, hooks, and failure-detection\nsettings for a single exporter instance.  The CLI writes new configs to\n``BASE_PATH`` (user config dir); ``SYSTEM_CONFIG_PATH`` is kept as a\nread fallback for production deployments (systemd units, containers).",
  "properties": {
    "apiVersion": {
      "const": "jumpstarter.dev/v1alpha1",
      "default": "jumpstarter.dev/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint"
    },
    "exitOnLeaseEnd": {
      "default": false,
      "title": "Exitonleaseend",
      "type": "boolean"
    },
    "export": {
      "additionalProperties": {
        "$ref": "#/$defs/ExporterConfigV1Alpha1DriverInstance"
      },
      "title": "Export",
      "type": "object"
    },
    "failureDetection": {
      "$ref": "#/$defs/FailureDetectionConfigV1Alpha1"
    },
    "grpcOptions": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Grpcoptions"
    },
    "hooks": {
      "$ref": "#/$defs/HookConfigV1Alpha1"
    },
    "kind": {
      "const": "ExporterConfig",
      "default": "ExporterConfig",
      "title": "Kind",
      "type": "string"
    },
