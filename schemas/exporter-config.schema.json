    "HookInstanceConfigV1Alpha1": {
      "description": "Configuration for a specific lifecycle hook.",
      "properties": {
        "exec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Interpreter used to execute the script (e.g. /bin/bash, python3). When not set, auto-detected from the script file extension (.py uses the exporter's Python, .sh uses /bin/sh) or defaults to /bin/sh for inline scripts.",
          "title": "Exec"
        },
        "onFailure": {
          "default": "warn",
          "description": "Action to take when the expected exit code is not returned: 'endLease' to end the lease, 'exit' takes the exporter offline and ends the lease, 'warn' continues and prints a warning",
          "enum": [
            "warn",
            "endLease",
            "exit"
          ],
          "title": "Onfailure",
          "type": "string"
        },
        "script": {
          "description": "The j script to execute for this hook",
          "title": "Script",
          "type": "string"
        },
        "timeout": {
          "default": 120,
          "description": "The hook execution timeout in seconds (default: 120s)",
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "script"
      ],
      "title": "HookInstanceConfigV1Alpha1",
      "type": "object"
    },
