{
  "name": "vscode-jumpstarter",
  "displayName": "Jumpstarter",
  "description": "Jumpstarter Hardware Testing support.",
  "version": "0.0.1",
  "publisher": "jumpstarter",
  "author": "Jumpstarter",
  "contributors": [
    {
      "name": "Kirk Brauer",
      "email": "kbrauer@hatci.com"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jumpstarter-dev/vscode-jumpstarter.git"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jumpstarter",
          "title": "Jumpstarter",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "jumpstarter": [
        {
          "id": "jumpstarter.clients",
          "name": "Clients",
          "icon": "$(zap)"
        },
        {
          "id": "jumpstarter.exporters",
          "name": "Exporters",
          "icon": "$(zap)"
        },
        {
          "id": "jumpstarter.leases",
          "name": "Leases",
          "icon": "$(zap)"
        },
        {
          "id": "jumpstarter.admin",
          "name": "Administration",
          "icon": "$(zap)",
          "visibility": "collapsed",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "id": "jumpstarter.details",
          "name": "Details",
          "type": "webview",
          "icon": "$(zap)",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "jumpstarter.refresh",
        "title": "Refresh",
        "category": "Jumpstarter",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpstarter.addClient",
        "title": "Add Client…",
        "category": "Jumpstarter",
        "icon": "$(add)"
      },
      {
        "command": "jumpstarter.clients.refresh",
        "title": "Refresh Clients",
        "category": "Jumpstarter",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpstarter.pickClient",
        "title": "Switch Client",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.useClient",
        "title": "Set as Current Client",
        "category": "Jumpstarter",
        "icon": "$(star-empty)"
      },
      {
        "command": "jumpstarter.reauthenticateClient",
        "title": "Re-authenticate Client",
        "category": "Jumpstarter",
        "icon": "$(key)"
      },
      {
        "command": "jumpstarter.openClientConfig",
        "title": "Edit Client Config",
        "category": "Jumpstarter",
        "icon": "$(edit)"
      },
      {
        "command": "jumpstarter.deleteClient",
        "title": "Delete Client",
        "category": "Jumpstarter",
        "icon": "$(trash)"
      },
      {
        "command": "jumpstarter.newClientConfig",
        "title": "New Client Config",
        "category": "Jumpstarter",
        "icon": "$(new-file)"
      },
      {
        "command": "jumpstarter.newExporterConfig",
        "title": "New Exporter Config",
        "category": "Jumpstarter",
        "icon": "$(new-file)"
      },
      {
        "command": "jumpstarter.exporters.refresh",
        "title": "Refresh Exporters",
        "category": "Jumpstarter",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpstarter.exporters.leaseFromSet",
        "title": "Lease from Exporter Set",
        "category": "Jumpstarter",
        "icon": "$(play)"
      },
      {
        "command": "jumpstarter.exporters.editConfig",
        "title": "Edit Exporter Config",
        "category": "Jumpstarter",
        "icon": "$(edit)"
      },
      {
        "command": "jumpstarter.exporters.filter",
        "title": "Filter Exporters by Selector",
        "category": "Jumpstarter",
        "icon": "$(filter)"
      },
      {
        "command": "jumpstarter.leaseBySelector",
        "title": "Lease by Label Selector…",
        "category": "Jumpstarter",
        "icon": "$(add)"
      },
      {
        "command": "jumpstarter.exporters.acquireLease",
        "title": "Acquire Lease",
        "category": "Jumpstarter",
        "icon": "$(play)"
      },
      {
        "command": "jumpstarter.connectDirect",
        "title": "Connect to Exporter Directly…",
        "category": "Jumpstarter",
        "icon": "$(plug)"
      },
      {
        "command": "jumpstarter.exporters.openLocalShell",
        "title": "Open Local Exporter Shell",
        "category": "Jumpstarter",
        "icon": "$(terminal)"
      },
      {
        "command": "jumpstarter.leases.refresh",
        "title": "Refresh Leases",
        "category": "Jumpstarter",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpstarter.leases.toggleEnded",
        "title": "Toggle Ended Leases",
        "category": "Jumpstarter",
        "icon": "$(history)"
      },
      {
        "command": "jumpstarter.leases.openShell",
        "title": "Open Shell in Lease",
        "category": "Jumpstarter",
        "icon": "$(terminal)"
      },
      {
        "command": "jumpstarter.leases.openWebUi",
        "title": "Open Screen and Tools",
        "category": "Jumpstarter",
        "icon": "$(open-preview)"
      },
      {
        "command": "jumpstarter.leases.openDriverView",
        "title": "Open View",
        "category": "Jumpstarter",
        "icon": "$(open-preview)"
      },
      {
        "command": "jumpstarter.leases.openFullWebUi",
        "title": "Open Full Web UI in Browser",
        "category": "Jumpstarter",
        "icon": "$(globe)"
      },
      {
        "command": "jumpstarter.webUi.stop",
        "title": "Stop Web UI Servers",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.leases.runCurrentFile",
        "title": "Run Current File in Lease",
        "category": "Jumpstarter",
        "icon": "$(play)"
      },
      {
        "command": "jumpstarter.leases.extend",
        "title": "Extend Lease…",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.leases.end",
        "title": "End Lease",
        "category": "Jumpstarter",
        "icon": "$(close)"
      },
      {
        "command": "jumpstarter.leases.copyExport",
        "title": "Copy JMP_LEASE Export Line",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.leases.refreshDevices",
        "title": "Refresh Drivers",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.leases.runDeviceCommand",
        "title": "Run in Lease Terminal",
        "category": "Jumpstarter",
        "icon": "$(play)"
      },
      {
        "command": "jumpstarter.pinLeaseForTests",
        "title": "Pin Lease for Test Runs",
        "category": "Jumpstarter",
        "icon": "$(pin)"
      },
      {
        "command": "jumpstarter.clearTestPin",
        "title": "Clear Test Lease Pin",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.manageTestPin",
        "title": "Manage Test Lease Pin",
        "category": "Jumpstarter"
      },
      {
        "command": "jumpstarter.admin.refresh",
        "title": "Refresh Cluster Resources",
        "category": "Jumpstarter",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpstarter.admin.setNamespace",
        "title": "Administer Namespace…",
        "category": "Jumpstarter",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "jumpstarter.admin.toggleEndedLeases",
        "title": "Toggle Ended Leases",
        "category": "Jumpstarter",
        "icon": "$(history)"
      },
      {
        "command": "jumpstarter.admin.newResource",
        "title": "New Cluster Resource…",
        "category": "Jumpstarter",
        "icon": "$(add)"
      },
      {
        "command": "jumpstarter.admin.importClient",
        "title": "Import Client Config",
        "category": "Jumpstarter",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jumpstarter.admin.importExporter",
        "title": "Import Exporter Config",
        "category": "Jumpstarter",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jumpstarter.importClientConfig",
        "title": "Import Client Config from Cluster…",
        "category": "Jumpstarter",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jumpstarter.importExporterConfig",
        "title": "Import Exporter Config from Cluster…",
        "category": "Jumpstarter",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jumpstarter.applyManifest",
        "title": "Apply to Cluster",
        "category": "Jumpstarter",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "jumpstarter.validateManifest",
        "title": "Validate Manifest Against the Cluster",
        "category": "Jumpstarter",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jumpstarter.exporters.openLocalShell",
          "when": "false"
        },
        {
          "command": "jumpstarter.exporters.editConfig",
          "when": "false"
        },
        {
          "command": "jumpstarter.exporters.leaseFromSet",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.openShell",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.openWebUi",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.openFullWebUi",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.runCurrentFile",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.extend",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.end",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.copyExport",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.refreshDevices",
          "when": "false"
        },
        {
          "command": "jumpstarter.leases.runDeviceCommand",
          "when": "false"
        },
        {
          "command": "jumpstarter.admin.importClient",
          "when": "false"
        },
        {
          "command": "jumpstarter.admin.importExporter",
          "when": "false"
        },
        {
          "command": "jumpstarter.importClientConfig",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "command": "jumpstarter.importExporterConfig",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "command": "jumpstarter.admin.newResource",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "command": "jumpstarter.admin.setNamespace",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "command": "jumpstarter.admin.refresh",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "command": "jumpstarter.admin.toggleEndedLeases",
          "when": "jumpstarter.adminAvailable"
        },
        {
          "command": "jumpstarter.applyManifest",
          "when": "jumpstarter.adminAvailable && jumpstarter.canApplyManifest"
        },
        {
          "command": "jumpstarter.validateManifest",
          "when": "jumpstarter.adminAvailable && jumpstarter.canApplyManifest"
        },
        {
          "command": "jumpstarter.leases.openDriverView",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "jumpstarter.addClient",
          "when": "view == jumpstarter.clients",
          "group": "navigation@1"
        },
        {
          "command": "jumpstarter.clients.refresh",
          "when": "view == jumpstarter.clients",
          "group": "navigation@2"
        },
        {
          "command": "jumpstarter.newClientConfig",
          "when": "view == jumpstarter.clients",
          "group": "1_new@1"
        },
        {
          "command": "jumpstarter.importClientConfig",
          "when": "view == jumpstarter.clients && jumpstarter.adminAvailable",
          "group": "1_new@2"
        },
        {
          "command": "jumpstarter.exporters.refresh",
          "when": "view == jumpstarter.exporters",
          "group": "navigation@1"
        },
        {
          "command": "jumpstarter.exporters.filter",
          "when": "view == jumpstarter.exporters",
          "group": "navigation@2"
        },
        {
          "command": "jumpstarter.leaseBySelector",
          "when": "view == jumpstarter.exporters",
          "group": "1_actions@1"
        },
        {
          "command": "jumpstarter.newExporterConfig",
          "when": "view == jumpstarter.exporters",
          "group": "2_new@1"
        },
        {
          "command": "jumpstarter.importExporterConfig",
          "when": "view == jumpstarter.exporters && jumpstarter.adminAvailable",
          "group": "2_new@2"
        },
        {
          "command": "jumpstarter.admin.newResource",
          "when": "view == jumpstarter.admin",
          "group": "navigation@1"
        },
        {
          "command": "jumpstarter.admin.setNamespace",
          "when": "view == jumpstarter.admin",
          "group": "navigation@2"
        },
        {
          "command": "jumpstarter.admin.toggleEndedLeases",
          "when": "view == jumpstarter.admin",
          "group": "navigation@3"
        },
        {
          "command": "jumpstarter.admin.refresh",
          "when": "view == jumpstarter.admin",
          "group": "navigation@4"
        },
        {
          "command": "jumpstarter.leaseBySelector",
          "when": "view == jumpstarter.leases",
          "group": "navigation@1"
        },
        {
          "command": "jumpstarter.connectDirect",
          "when": "view == jumpstarter.leases",
          "group": "navigation@2"
        },
        {
          "command": "jumpstarter.leases.refresh",
          "when": "view == jumpstarter.leases",
          "group": "navigation@3"
        },
        {
          "command": "jumpstarter.leases.toggleEnded",
          "when": "view == jumpstarter.leases",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jumpstarter.useClient",
          "when": "view == jumpstarter.clients && viewItem =~ /^jumpstarterClient(NeedsAuth)?$/",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.reauthenticateClient",
          "when": "view == jumpstarter.clients && viewItem =~ /NeedsAuth/",
          "group": "inline@2"
        },
        {
          "command": "jumpstarter.openClientConfig",
          "when": "view == jumpstarter.clients && viewItem =~ /^jumpstarterClient/",
          "group": "inline@3"
        },
        {
          "command": "jumpstarter.useClient",
          "when": "view == jumpstarter.clients && viewItem =~ /^jumpstarterClient(NeedsAuth)?$/",
          "group": "1_actions@1"
        },
        {
          "command": "jumpstarter.reauthenticateClient",
          "when": "view == jumpstarter.clients && viewItem =~ /^jumpstarterClient/",
          "group": "1_actions@2"
        },
        {
          "command": "jumpstarter.openClientConfig",
          "when": "view == jumpstarter.clients && viewItem =~ /^jumpstarterClient/",
          "group": "2_manage@1"
        },
        {
          "command": "jumpstarter.deleteClient",
          "when": "view == jumpstarter.clients && viewItem =~ /^jumpstarterClient/",
          "group": "2_manage@2"
        },
        {
          "command": "jumpstarter.exporters.acquireLease",
          "when": "view == jumpstarter.exporters && viewItem =~ /^exporter-available/",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.exporters.editConfig",
          "when": "view == jumpstarter.exporters && viewItem =~ /-local$/",
          "group": "inline@2"
        },
        {
          "command": "jumpstarter.exporters.leaseFromSet",
          "when": "view == jumpstarter.exporters && viewItem == exporter-set",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.exporters.openLocalShell",
          "when": "view == jumpstarter.exporters && viewItem == exporter-local",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.exporters.editConfig",
          "when": "view == jumpstarter.exporters && viewItem == exporter-local",
          "group": "inline@2"
        },
        {
          "command": "jumpstarter.exporters.leaseFromSet",
          "when": "view == jumpstarter.exporters && viewItem == exporter-set",
          "group": "1_actions@1"
        },
        {
          "command": "jumpstarter.exporters.acquireLease",
          "when": "view == jumpstarter.exporters && viewItem =~ /^exporter-available/",
          "group": "1_actions@1"
        },
        {
          "command": "jumpstarter.leases.openShell",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-inUse/",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.leases.openWebUi",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-inUse/",
          "group": "inline@2"
        },
        {
          "command": "jumpstarter.leases.openWebUi",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-inUse/",
          "group": "1_run@2"
        },
        {
          "command": "jumpstarter.leases.openFullWebUi",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-inUse/",
          "group": "1_run@3"
        },
        {
          "command": "jumpstarter.leases.end",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-(inUse|waiting)/",
          "group": "inline@3"
        },
        {
          "command": "jumpstarter.leases.runCurrentFile",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-inUse/",
          "group": "1_run@1"
        },
        {
          "command": "jumpstarter.pinLeaseForTests",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-(inUse|waiting)/",
          "group": "1_run@2"
        },
        {
          "command": "jumpstarter.leases.extend",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-(inUse|waiting)/",
          "group": "2_manage@1"
        },
        {
          "command": "jumpstarter.leases.end",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-(inUse|waiting)/",
          "group": "2_manage@2"
        },
        {
          "command": "jumpstarter.leases.copyExport",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease/",
          "group": "3_copy@1"
        },
        {
          "command": "jumpstarter.leases.refreshDevices",
          "when": "view == jumpstarter.leases && viewItem =~ /^jumpstarterLease-inUse/",
          "group": "4_drivers@1"
        },
        {
          "command": "jumpstarter.leases.runDeviceCommand",
          "when": "view == jumpstarter.leases && viewItem == jumpstarterDeviceCommand",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.admin.importClient",
          "when": "view == jumpstarter.admin && viewItem == admin-client",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.admin.importClient",
          "when": "view == jumpstarter.admin && viewItem =~ /^admin-client/",
          "group": "1_config@1"
        },
        {
          "command": "jumpstarter.admin.importExporter",
          "when": "view == jumpstarter.admin && viewItem == admin-exporter",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.admin.importExporter",
          "when": "view == jumpstarter.admin && viewItem == admin-exporter",
          "group": "1_config@1"
        },
        {
          "command": "jumpstarter.leases.openDriverView",
          "when": "view == jumpstarter.leases && viewItem == jumpstarterDriver-web",
          "group": "inline@1"
        },
        {
          "command": "jumpstarter.leases.openDriverView",
          "when": "view == jumpstarter.leases && viewItem == jumpstarterDriver-web",
          "group": "1_run@1"
        }
      ],
      "editor/title": [
        {
          "command": "jumpstarter.applyManifest",
          "when": "jumpstarter.canApplyManifest && jumpstarter.adminAvailable",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "jumpstarter.applyManifest",
          "when": "jumpstarter.canApplyManifest && jumpstarter.adminAvailable",
          "group": "jumpstarter@1"
        },
        {
          "command": "jumpstarter.validateManifest",
          "when": "jumpstarter.canApplyManifest && jumpstarter.adminAvailable",
          "group": "jumpstarter@2"
        }
      ]
    },
    "configuration": {
      "title": "Jumpstarter",
      "properties": {
        "jumpstarter.jmpPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `jmp` executable. When set, it is invoked directly instead of resolving `jumpstarter_cli` from the active Python environment."
        },
        "jumpstarter.kubectlPath": {
          "type": "string",
          "default": "kubectl",
          "markdownDescription": "Path to `kubectl`, used for manifest apply and server-side dry-run validation when `jmp admin apply` is unavailable. Defaults to `kubectl` on the extension host's PATH."
        },
        "jumpstarter.experimentalCliFeatures": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable Jumpstarter CLI features that are not yet available on the current `main` branch. Use only with the `ide-cli-integration` CLI branch."
        },
        "jumpstarter.experimentalDriverSchemas": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable environment-aware driver YAML completion, validation, and driver-client allow-list suggestions. Requires `jumpstarter.experimentalCliFeatures` and a compatible CLI providing `jmp driver schema`. Imports locally installed driver modules to inspect them; leave disabled unless you trust those packages."
        },
        "jumpstarter.admin.namespace": {
          "type": "string",
          "default": "",
          "markdownDescription": "Kubernetes namespace the Administration view reads. When empty, follows the namespace of the current client config."
        },
        "jumpstarter.admin.kubeconfig": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the kubeconfig used for cluster administration. When empty, the usual `KUBECONFIG` / `~/.kube/config` resolution applies."
        },
        "jumpstarter.admin.context": {
          "type": "string",
          "default": "",
          "markdownDescription": "Kubeconfig context used for cluster administration. When empty, the current context is used."
        },
        "jumpstarter.pollIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "How often (in seconds) the Jumpstarter views poll the controller for exporters and leases."
        },
        "jumpstarter.webUi.tools": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "markdownDescription": "What **Open Screen and Tools** shows of a lease, as entries of [Jumpstarter Web](https://github.com/jumpstarter-dev/jumpstarter-web): plugin ids (`hmi`), view ids (`hmi/screen`) or kinds of centre view (`@display`, `@tool`, `@terminal`). Left unset, it is every installed plugin that has a display or a tool to show in the centre; terminals, the driver tree and other tool windows have native counterparts in VS Code. An empty list shows the whole workbench."
        },
        "jumpstarter.webUi.openIn": {
          "type": "string",
          "enum": [
            "panel",
            "browser"
          ],
          "default": "panel",
          "enumDescriptions": [
            "A panel beside the editor, themed like the rest of the window.",
            "The system browser."
          ],
          "markdownDescription": "Where a lease's screen and tools, and a driver's view, open. The full Web UI always opens in the system browser."
        },
        "jumpstarter.webUi.frameOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "vscode-webview:",
            "vscode-file:"
          ],
          "markdownDescription": "What may show Jumpstarter Web in a frame, passed to `jumpstarter-web serve --allowed-frame-origin`: an origin (`https://ide.example.com`) or an application's scheme. The default is a panel of a desktop VS Code window (the webview and the window it is part of); a browser-hosted VS Code (Eclipse Che, code-server) needs the origin its webviews are served from."
        },
        "jumpstarter.webUi.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `jumpstarter-web` executable. When empty, it is taken from the environment `jmp` runs from."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:real": "pnpm run compile-tests && pnpm run compile && vscode-test --config .vscode-test.real.mjs",
    "test:unit": "pnpm run compile-tests && node --test \"out/test/unit/**/*.test.js\"",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.5"
  },
  "packageManager": "pnpm@11.24.0"
}
